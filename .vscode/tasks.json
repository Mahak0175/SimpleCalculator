{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build SimpleCalculator",
            "type": "shell",
            "command": "javac",
            "args": [
                "-d",
                "bin",
                "src/CalculatorEngine.java",
                "src/SimpleCalculator.java",
                "src/CalculatorTest.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$javac"]
        },
        {
            "label": "Run Automated Tests",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp",
                "bin",
                "CalculatorTest"
            ],
            "dependsOn": "Build SimpleCalculator",
            "group": "test",
            "problemMatcher": []
        }
    ]
}
